<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    数据库连接
    · 默认用 Windows 集成身份验证：不把密码写进源码目录，任何用本机管理员账号登录的
      机器都能直接连上，适合课程设计反复换机编译的场景。
    · 若你的 SQL Server 只允许 sa 登录（仅 SQL Server 身份验证），把下面的 connectionString 换成：
        Server=localhost;Database=LibraryDB;User Id=sa;Password=你的密码;Connect Timeout=5;
      注意：SQL Server 默认是「仅 Windows 身份验证」，只有开启混合模式并启用 sa 才能这样连。
    · 命名实例（705 教室）：把 Server=localhost 改为 Server=localhost\SQLEXPRESS。
  -->
  <connectionStrings>
    <add name="LibraryDB"
         connectionString="Server=localhost;Database=LibraryDB;Integrated Security=True;Connect Timeout=5;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
